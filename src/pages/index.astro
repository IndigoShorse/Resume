---
import Layout from '@/layouts/Layout.astro'
import ResumeHero from '@/components/resume/astro/ResumeHero.astro'
import ImplSwitcher from '@/components/resume/astro/ImplSwitcher.astro'
import ResumeModes from '@/components/resume/vue/ResumeModes.vue'
import { getDict } from '@/i18n'

const dict = getDict()
---

<Layout title={dict.home.title} description={dict.home.description}>
  <div class="resume">
    <ResumeHero />

    <ImplSwitcher current="astro" />

    <ResumeModes client:load />
  </div>
</Layout>
