import ImplSwitcher from '@/components/resume/astro/ImplSwitcher.astro'
import ResumeModes from '@/components/resume/vue/ResumeModes.vue'
---

<Layout
  title="Сурков Даниил — Frontend-разработчик"
  description="Резюме-визитка Даниила Суркова: frontend-разработчик (Vue / React / TypeScript). Стили отображения собраны из компонентов собственной UI-библиотеки."
>
  <div class="resume">
    <ResumeHero />

    <ImplSwitcher current="astro" />

    <ResumeModes client:load />
  </div>
</Layout>
