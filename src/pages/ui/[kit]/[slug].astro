---
import KitLayout from '@/layouts/KitLayout.astro'
import ComponentShowcase from '@/components/showcase/ComponentShowcase.vue'
import { kits } from '@/data/registry'
import { getDict, format } from '@/i18n'
import { Code } from 'astro:components'

export function getStaticPaths() {
  return kits.flatMap((kit) =>
    kit.components.map((meta) => ({ params: { kit: kit.key, slug: meta.slug } })),
  )
}

const kit = kits.find((k) => k.key === Astro.params.kit)!
const meta = kit.components.find((m) => m.slug === Astro.params.slug)!
const source = kit.sourceMap[meta.slug]
const dict = getDict().kitPage
---

<KitLayout
  kit={kit}
  currentSlug={meta.slug}
  title={format(dict.componentTitle, { name: meta.name, title: kit.title })}
  description={meta.description}
>
  <h1 class="page-title">{meta.name}</h1>
  <p class="page-subtitle">{meta.description}</p>

  <ComponentShowcase client:load kit={kit.key} slug={meta.slug} />

  <details class="code-block">
    <summary class="code-block__summary">{format(dict.source, { name: meta.name })}</summary>
    <div class="code-block__body">
      <button class="code-block__copy" type="button" data-copied-label={dict.copied}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span>{dict.copy}</span>
      </button>
      <Code code={source} lang="vue" theme="github-light" />
    </div>
  </details>
</KitLayout>

<script>
  // Кнопка внутри Vue-острова (.code-block--usage) обрабатывается самим компонентом
  document.querySelectorAll<HTMLButtonElement>('.code-block:not(.code-block--usage) .code-block__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.code-block__body')?.querySelector('pre')
      const label = btn.querySelector('span')
      if (!pre || !label) return
      await navigator.clipboard.writeText(pre.textContent ?? '')
      const prev = label.textContent
      label.textContent = btn.dataset.copiedLabel ?? prev
      setTimeout(() => (label.textContent = prev), 1500)
    })
  })
</script>
