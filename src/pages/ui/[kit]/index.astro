---
import KitLayout from '@/layouts/KitLayout.astro'
import { kits } from '@/data/registry'

export function getStaticPaths() {
  return kits.map((kit) => ({ params: { kit: kit.key } }))
}

const kit = kits.find((k) => k.key === Astro.params.kit)!
---

<KitLayout kit={kit} title={`UI-библиотека ${kit.title}`} description={kit.description}>
  <h1 class="page-title">UI-библиотека {kit.title}</h1>
  <p class="page-subtitle">{kit.description}</p>

  <div class="ui-grid">
    {
      kit.components.map((meta) => (
        <a href={`/ui/${kit.key}/${meta.slug}`} class="ui-grid__card">
          <span class="ui-grid__name">{meta.name}</span>
          <p class="ui-grid__description">{meta.description}</p>
        </a>
      ))
    }
  </div>
</KitLayout>
