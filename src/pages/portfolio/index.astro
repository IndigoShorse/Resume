---
import Layout from '@/layouts/Layout.astro'
import PortfolioGallery from '@/components/portfolio/PortfolioGallery.vue'
import { getPortfolio } from '@/data/portfolio'
import { defaultLocale, getDict, type Locale } from '@/i18n'
import { withLocale } from '@/utils/url'

const locale: Locale = Astro.props.locale ?? defaultLocale
const visibleProjects = getPortfolio(locale).filter((project) => project.visibleInPortfolio)
const dict = getDict(locale).portfolioPage
---

<Layout title={dict.title} description={dict.description} locale={locale}>
  <div class="portfolio-page">
    <header class="page-intro" data-reveal>
      <p class="eyebrow">{dict.eyebrow}</p>
      <h1>{dict.heading}</h1>
    <p>{dict.intro}</p>
    </header>
    <div class="portfolio-list">
      {visibleProjects.map((project, index) => (
        <article class="portfolio-item" data-reveal>
          <div class="portfolio-item__body">
            <span class="portfolio-item__index">{String(index + 1).padStart(2, '0')} / {project.category}</span>
            <h2>{project.title}</h2>
            <p class="portfolio-item__summary">{project.summary}</p>
            <div class="resume-tags">{project.stack.map((tag) => <span>{tag}</span>)}</div>
            <details class="portfolio-item__details">
              <summary>{dict.details} <span aria-hidden="true">⌄</span></summary>
              <div>{project.details.map((paragraph) => <p>{paragraph}</p>)}</div>
            </details>
            {project.links?.length && <div class="portfolio-item__links">{project.links.map((link) => <a href={link.internal ? withLocale(link.href, locale) : link.href} target={link.internal ? undefined : '_blank'} rel={link.internal ? undefined : 'noopener noreferrer'}>{link.label} ↗</a>)}</div>}
          </div>
          <PortfolioGallery client:visible images={project.images} title={project.title} locale={locale} />
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('.portfolio-page')
  const motionAllowed = !window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (page && motionAllowed && 'IntersectionObserver' in window) {
    const blocks = Array.from(page.querySelectorAll<HTMLElement>('[data-reveal]'))
    page.classList.add('portfolio-page--reveal-ready')

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => blocks.indexOf(a.target as HTMLElement) - blocks.indexOf(b.target as HTMLElement))

      visible.forEach((entry, index) => {
        const block = entry.target as HTMLElement
        block.style.setProperty('--reveal-delay', `${Math.min(index, 3) * 80}ms`)
        block.classList.add('is-visible')
        observer.unobserve(block)
      })
    }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' })

    blocks.forEach((block) => observer.observe(block))
    page.addEventListener('focusin', (event) => {
      const block = (event.target as Element).closest<HTMLElement>('[data-reveal]')
      if (block) {
        block.classList.add('is-visible')
        observer.unobserve(block)
      }
    })
  }
</script>
