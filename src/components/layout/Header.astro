---
import { getDict, type Locale } from "@/i18n";
import { stripBase, withLocale } from "@/utils/url";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
const pathname =
  stripBase(Astro.url.pathname).replace(/^\/ru(?=\/|$)/, "") || "/";
const otherLocale: Locale = locale === "en" ? "ru" : "en";
---

<header class="site-header">
  <nav class="site-header__nav">
    <a
      href={withLocale("/", locale)}
      class="site-header__logo"
      aria-label={dict.site.logoAria}
      ><span class="site-header__logo-part site-header__logo-part--indigo"
        >Indigo</span
      ><span class="site-header__logo-part site-header__logo-part--shorse"
        >Shorse</span
      ></a
    >
    <a
      href={withLocale("/", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname === "/" },
      ]}>{dict.site.nav.resume}</a
    >
    <a
      href={withLocale("/portfolio", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname.startsWith("/portfolio") },
      ]}>{dict.site.nav.portfolio}</a
    >
    <a
      href={withLocale("/library", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname.startsWith("/library") },
      ]}>{dict.site.nav.library}</a
    >
    <a
      class="site-header__language"
      href={withLocale(pathname, otherLocale)}
      aria-label={dict.site.language.switchAria}>{dict.site.language.label}</a
    >
    <button
      class="site-header__theme"
      type="button"
      aria-label={dict.site.theme.toggle}
      title={dict.site.theme.toggle}
      data-theme-toggle
      data-theme-light-label={dict.site.theme.enableLight}
      data-theme-dark-label={dict.site.theme.enableDark}
    >
      <svg
        class="site-header__theme-icon site-header__theme-icon--moon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M20.2 15.4A8.7 8.7 0 0 1 8.6 3.8 8.7 0 1 0 20.2 15.4Z"
        ></path></svg
      >
      <svg
        class="site-header__theme-icon site-header__theme-icon--sun"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path></svg
      >
    </button>
  </nav>
</header>
