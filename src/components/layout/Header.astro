---
import { getDict, type Locale } from "@/i18n";
import { stripBase, withLocale } from "@/utils/url";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
const pathname =
  stripBase(Astro.url.pathname).replace(/^\/ru(?=\/|$)/, "") || "/";
const otherLocale: Locale = locale === "en" ? "ru" : "en";
---

<header class="site-header">
  <nav class="site-header__nav">
    <a
      href={withLocale("/", locale)}
      class="site-header__logo"
      aria-label={dict.site.logoAria}
      ><span class="site-header__logo-part site-header__logo-part--indigo"
        >Indigo</span
      ><span class="site-header__logo-part site-header__logo-part--shorse"
        >Shorse</span
      ></a
    >
    <a
      href={withLocale("/", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname === "/" },
      ]}>{dict.site.nav.resume}</a
    >
    <a
      href={withLocale("/portfolio", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname.startsWith("/portfolio") },
      ]}>{dict.site.nav.portfolio}</a
    >
    <a
      href={withLocale("/library", locale)}
      class:list={[
        "site-header__link",
        { "site-header__link--active": pathname.startsWith("/library") },
      ]}>{dict.site.nav.library}</a
    >
    <a
      class="site-header__language"
      href={withLocale(pathname, otherLocale)}
      aria-label={dict.site.language.switchAria}>{dict.site.language.label}</a
    >
    <button
      class="site-header__theme"
      type="button"
      aria-label={dict.site.theme.toggle}
      title={dict.site.theme.toggle}
      data-theme-toggle
      data-theme-light-label={dict.site.theme.enableLight}
      data-theme-dark-label={dict.site.theme.enableDark}
    >
      <svg
        class="site-header__theme-icon site-header__theme-icon--moon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        ><path
          fill="currentColor"
          d="M12.075 22q-2.1 0-3.937-.8t-3.2-2.162t-2.163-3.2t-.8-3.938q0-3.1 1.713-5.625t4.587-3.7q.35-.125.725-.088t.625.238q.2.175.313.488t.112.812q.05 1.975.8 3.763T13 10.975t3.2 2.15t3.775.8q.525 0 .8.088t.45.287q.2.25.263.65t-.063.725q-1.15 2.875-3.7 4.6T12.075 22m0-2q2.2 0 4.075-1.1t2.95-3.025q-2.15-.2-4.075-1.087t-3.45-2.413t-2.425-3.45T8.075 4.85Q6.15 5.925 5.063 7.813T3.975 11.9q0 3.375 2.363 5.738T12.075 20M14.3 7.3l-1.6-1.6q-.3-.3-.3-.7t.3-.7l1.6-1.6q.3-.3.7-.3t.7.3l1.6 1.6q.3.3.3.7t-.3.7l-1.6 1.6q-.3.3-.7.3t-.7-.3m5 3l-.6-.6q-.3-.3-.3-.7t.3-.7l.6-.6q.3-.3.7-.3t.7.3l.6.6q.3.3.3.7t-.3.7l-.6.6q-.3.3-.7.3t-.7-.3"
        ></path></svg
      >
      <svg
        class="site-header__theme-icon site-header__theme-icon--sun"
        viewBox="0 0 24 24"
        aria-hidden="true"
        ><path
          fill="currentColor"
          d="M11.288 4.713Q11 4.425 11 4V2q0-.425.288-.712T12 1t.713.288T13 2v2q0 .425-.288.713T12 5t-.712-.288M16.95 7.05q-.275-.275-.275-.687t.275-.713l1.4-1.425q.3-.3.712-.3t.713.3q.275.275.275.7t-.275.7L18.35 7.05q-.275.275-.7.275t-.7-.275M20 13q-.425 0-.713-.288T19 12t.288-.712T20 11h2q.425 0 .713.288T23 12t-.288.713T22 13zm-8.712 9.713Q11 22.425 11 22v-2q0-.425.288-.712T12 19t.713.288T13 20v2q0 .425-.288.713T12 23t-.712-.288M5.65 7.05l-1.425-1.4q-.3-.3-.3-.725t.3-.7q.275-.275.7-.275t.7.275L7.05 5.65q.275.275.275.7t-.275.7q-.3.275-.7.275t-.7-.275m12.7 12.725l-1.4-1.425q-.275-.3-.275-.712t.275-.688t.688-.275t.712.275l1.425 1.4q.3.275.288.7t-.288.725q-.3.3-.725.3t-.7-.3M2 13q-.425 0-.712-.288T1 12t.288-.712T2 11h2q.425 0 .713.288T5 12t-.288.713T4 13zm2.225 6.775q-.275-.275-.275-.7t.275-.7L5.65 16.95q.275-.275.687-.275t.713.275q.3.3.3.713t-.3.712l-1.4 1.4q-.3.3-.725.3t-.7-.3M7.75 16.25Q6 14.5 6 12t1.75-4.25T12 6t4.25 1.75T18 12t-1.75 4.25T12 18t-4.25-1.75m7.075-1.425Q16 13.65 16 12t-1.175-2.825T12 8T9.175 9.175T8 12t1.175 2.825T12 16t2.825-1.175M12 12"
        ></path></svg
      >
    </button>
  </nav>
</header>
