---
// Левое меню раздела UI-библиотеки:
// список подразделов-компонентов строится из реестра кита.
import type { KitRegistry } from '@/data/registry'
import { getDict, format } from '@/i18n'
import { withBase } from '@/utils/url'
import { withLocale } from '@/utils/url'
import type { Locale } from '@/i18n'

interface Props {
  kit: KitRegistry
  currentSlug?: string
  locale?: Locale
}

const { kit, currentSlug, locale = 'en' } = Astro.props
---

<aside class="docs__sidebar">
  <a class="docs__sidebar-parent" href={withLocale('/library', locale)}>{getDict(locale).libraryPage.back}</a>
  <a
    href={withLocale(`/library/${kit.key}`, locale)}
    class:list={['docs__sidebar-title', { 'docs__sidebar-title--active': !currentSlug }]}
  >
    {kit.title}
  </a>
  <nav class="docs__sidebar-nav" aria-label={format(getDict().kitPage.sidebarAria, { title: kit.title })}>
    {kit.components.map((meta) => (
      <a
        href={withLocale(`/library/${kit.key}/${meta.slug}`, locale)}
        class:list={['docs__sidebar-link', { 'docs__sidebar-link--active': meta.slug === currentSlug }]}
      >
        {meta.name}
      </a>
    ))}
  </nav>
</aside>
