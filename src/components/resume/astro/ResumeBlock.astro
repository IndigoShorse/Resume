---
// Astro-версия универсального «тела» блока — та же разметка и классы,
// что у Vue-версии (ResumeBlockView.vue), стили общие в assets/css/resume.css.
import type { ResumeBlock } from '@/data/resume'

interface Props {
  block: ResumeBlock
  hideHeading?: boolean
}

const { block, hideHeading = false } = Astro.props
---

<div class="resume-block">
  {!hideHeading && (block.heading || block.meta) && (
    <header class="resume-block__header">
      {block.heading && <h4 class="resume-block__heading">{block.heading}</h4>}
      {block.meta && <span class="resume-block__meta">{block.meta}</span>}
    </header>
  )}
  {hideHeading && block.meta && <span class="resume-block__meta">{block.meta}</span>}

  {block.subheading && <p class="resume-block__subheading">{block.subheading}</p>}

  {block.text && <p class="resume-block__text">{block.text}</p>}

  {block.items && block.items.length > 0 && (
    <ul class="resume-block__items">
      {block.items.map((item) => <li>{item}</li>)}
    </ul>
  )}

  {block.tags && block.tags.length > 0 && (
    <div class="resume-block__tags">
      {block.tags.map((tag) => <span class="resume-block__tag">{tag}</span>)}
    </div>
  )}

  {block.level && (
    <div class="resume-block__level" aria-label={`Уровень ${block.level} из 5`}>
      {Array.from({ length: 5 }, (_, idx) => (
        <span
          class:list={[
            'resume-block__dot',
            { 'resume-block__dot--active': idx < (block.level ?? 0) },
          ]}
        />
      ))}
    </div>
  )}

  {block.links && block.links.length > 0 && (
    <div class="resume-block__links">
      {block.links.map((link) => (
        <a class="ui-button ui-button--color-plain" href={link.href}>{link.label}</a>
      ))}
    </div>
  )}
</div>
