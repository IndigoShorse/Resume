---
// Astro-рендерер секции в типографском стиле (аналог renderers/PlainSection.vue).
import type { ResumeSectionData } from '@/data/resume'
import ResumeBlock from './ResumeBlock.astro'

interface Props {
  section: ResumeSectionData
}

const { section } = Astro.props
---

<section class="plain-section">
  <h3 class="plain-section__title">{section.title}</h3>
  <div class="ui-divider" style="width: 100%; margin-bottom: 18px;"></div>
  {section.blocks.map((block, idx) => (
    <>
      <ResumeBlock block={block} />
      {idx < section.blocks.length - 1 && (
        <div class="ui-divider" style="width: 60%; margin-bottom: 0;"></div>
      )}
    </>
  ))}
</section>
