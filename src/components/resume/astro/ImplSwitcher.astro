---
// Вкладки визитки: Astro — резюме со стилями отображения,
// Vue — интерактивный шоукейс компонентов UI-библиотеки, позже React.
interface Props {
  current: 'astro' | 'vue'
}

const { current } = Astro.props

const impls = [
  { key: 'astro', label: 'Astro', href: '/' },
  { key: 'vue', label: 'Vue', href: '/ui/med' },
]
---

<div class="resume__switcher" role="group" aria-label="Вкладки">
  <span class="resume__switcher-label">Вкладки:</span>
  {impls.map((impl) => (
    <a
      href={impl.href}
      class:list={[
        'ui-button',
        current === impl.key ? 'ui-button--color-primary' : 'ui-button--color-secondary',
      ]}
    >
      {impl.label}
    </a>
  ))}
  <span class="ui-button ui-button--color-secondary resume__impl-soon">React — скоро</span>
</div>
