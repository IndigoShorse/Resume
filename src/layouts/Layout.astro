---
import "@/assets/css/dtdp/main.pcss";
import "@/assets/css/real_estate/main.pcss";
import "@/assets/css/app/main.css";
import "@/assets/css/global.css";
import "@/assets/css/app/resume.css";
import "@/assets/css/app/showcase.css";
import "@/assets/css/app/panel.css";
import "@/assets/css/app/pages.css";
import Header from "@/components/layout/Header.astro";
import { defaultLocale, getDict, type Locale } from "@/i18n";
import { withBase } from "@/utils/url";

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
  locale?: Locale;
}
const { title, mainClass, locale = defaultLocale } = Astro.props;
const description = Astro.props.description ?? getDict(locale).site.description;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("site-theme");
        document.documentElement.dataset.theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <Header locale={locale} />
    <main class:list={["site-main", mainClass]}><slot /></main>
    <script is:inline>
      const themeButton = document.querySelector("[data-theme-toggle]");
      const root = document.documentElement;
      if (themeButton) {
        let switching = false;
        const syncLabel = () => {
          const label =
            root.dataset.theme === "dark"
              ? themeButton.dataset.themeLightLabel
              : themeButton.dataset.themeDarkLabel;
          themeButton.setAttribute("aria-label", label);
          themeButton.setAttribute("title", label);
        };
        syncLabel();
        themeButton.addEventListener("click", () => {
          if (switching) return;
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          const changeTheme = () => {
            root.dataset.theme = nextTheme;
            syncLabel();
            try {
              localStorage.setItem("site-theme", nextTheme);
            } catch {}
          };
          if (
            !document.startViewTransition ||
            matchMedia("(prefers-reduced-motion: reduce)").matches
          )
            return changeTheme();
          const bounds = themeButton.getBoundingClientRect();
          const x = bounds.left + bounds.width / 2;
          const y = bounds.top + bounds.height / 2;
          root.style.setProperty("--theme-reveal-x", `${x}px`);
          root.style.setProperty("--theme-reveal-y", `${y}px`);
          root.style.setProperty(
            "--theme-reveal-radius",
            `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`,
          );
          root.classList.add("theme-view-transition");
          switching = true;
          document.startViewTransition(changeTheme).finished.finally(() => {
            switching = false;
            root.classList.remove("theme-view-transition");
            root.style.removeProperty("--theme-reveal-x");
            root.style.removeProperty("--theme-reveal-y");
            root.style.removeProperty("--theme-reveal-radius");
          });
        });
      }
    </script>
  </body>
</html>
