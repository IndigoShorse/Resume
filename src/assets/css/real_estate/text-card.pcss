.re-text-card {
    padding: 12px 0 28px;
    color: var(--re-primary);
}

.re-text-card--center {
    text-align: center;
}

.re-text-card--right {
    text-align: right;
}

.re-text-card__header {
    display: flex;
    align-items: center;
    gap: 18px;
}

.re-text-card--center .re-text-card__header {
    justify-content: center;
}

.re-text-card--right .re-text-card__header {
    justify-content: flex-end;
}

.re-text-card h3 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 23px;
}

.re-text-card__body {
    margin-top: 20px;
    color: var(--re-muted);
    font-size: 18px;
    line-height: 1.5;
}