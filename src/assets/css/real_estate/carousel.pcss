.re-carousel {
    max-width: 680px;
    border-radius: 10px;
    background: #1a1817;
}

.re-carousel__slide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: center;
    padding: 28px 52px;
}

.re-carousel__item {
    padding: 32px 20px;
    border-radius: 8px;
    background: #292726;
    color: var(--re-primary);
    font-family: Georgia, serif;
    font-size: 20px;
    text-align: center;
}