.re-card {
    overflow: hidden;
    border-radius: 10px;
    color: var(--re-primary);
}

.re-card__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 28px 0;
}

.re-card__header h3 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 23px;
}

.re-card__body {
    padding: 20px 28px 30px;
    color: var(--re-muted);
    font-size: 17px;
    line-height: 1.5;
}