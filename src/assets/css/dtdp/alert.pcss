.ui-alert {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.ui-alert svg{
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    padding: 0 20px;
}

.ui-alert__text {
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--subtitle-color);
    letter-spacing: 1px;
}

/* Варианты: перекрашивают stroke иконки (перебивает атрибут stroke в svg) */
.ui-alert--warning svg path {
    stroke: var(--warning-color);
}

.ui-alert--error svg path {
    stroke: var(--danger-color);
}
.ui-alert--error .ui-alert__text {
    color: var(--danger-color);
}

.ui-alert--info svg path {
    stroke: var(--info-color);
}

.ui-alert--success svg path {
    stroke: var(--success-color);
}
