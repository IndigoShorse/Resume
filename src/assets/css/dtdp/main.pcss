@import 'button.pcss';
@import 'icon.pcss';
@import 'card.pcss';
@import 'container.pcss';
@import 'form.pcss';
@import 'input.pcss';
@import 'alert.pcss';
@import 'modal.pcss';
@import 'carousel.pcss';
@import 'breadcrumbs.pcss';

@font-face {
    font-family: 'Inter';
    src: url('../../fonts/Inter-VariableFont_opsz,wght.ttf') format('truetype');
    font-weight: 100 900;
    font-display: swap;
    font-style: normal;
}

:root {
    --primary-color: #92daf0;
    --bg-color: #F8FAFC;
    --border-color: #E2E8F0;
    --text-color: #020617;
    --text-color-link: #1d809e;
    --subtitle-color: #64748B;
    --primary-text-color: #020617;
    --surface-color: #fff;
    --surface-muted-color: #F1F5F9;
    --field-color: #FAFAFA;
    --body-copy-color: #405366;
    --shadow-form: 0 0 10px rgb(0 0 0 / 10%);
    --shadow-card: 0 0 10px rgb(0 0 0 / 5%);
    --shadow-card-hover: 0 4px 8px rgb(0 0 0 / 20%);
    --shadow-inset: inset 0 0 4px rgb(0 0 0 / 10%);
    --danger-color: #ef4444;
    --warning-color: #f59e0b;
    --info-color: #0ea5e9;
    --success-color: #22c55e;
    --modal-scrim-color: #33415599;

    --container-width: 1040px;
    --button-radius: 8px;
    --radius: .625rem;

    --font-size-small: 12px;
    --font-size-default: 14px;
    --font-size-large: 24px;

    --min-button-height: 36px;
    --img-height: 364px;
}

* {
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size-default);
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    margin: 0;

    font-optical-sizing: auto;
    font-weight: 400;
    font-style: normal;
}

.main {
    position: relative;
    width: 100%;
}

.main-title {
    font-size: 30px;
    padding: 0;
    margin: 0;
}


.ui-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;

    margin-bottom: 18px;
    min-height: 36px;

    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
}
.ui-back:hover {
    opacity: 0.8;
}

.ui-back__icon {
    color: var(--subtitle-color);
}

.ui-back__label {
    color: var(--body-copy-color);
    font-size: 16px;
    font-weight: 500;
}

.ui-divider {
    background: var(--border-color);
    height: 1px;
    margin: 0 auto;
}

.hidden {
    display: none;
}

[class*="ui-margin-["] {
    margin: var(--margin-val);
}
