.ui-header__wrap {
    background: var(--primary-color);
    display: flex;
    justify-content: center;

    width: 100%;
}

.ui-header {
    width: var(--container-width);

    min-height: 56px;

    display: flex;
    justify-content: flex-end;
    align-items: center;
}

.ui-header__user {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--bg-color);
    overflow: hidden;
}