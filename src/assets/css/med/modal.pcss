.ui-modal__bg {
    background: #33415599;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
}

.ui-modal {
    top: 50%;
    left: 50%;
    position: absolute;
    transform: translate(-50%, -50%);
    width: 320px;

    border: 1px solid var(--border-color);
    background: #fff;
}

.ui-modal__content {
    width: 100%;
    padding: 30px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;

    text-align: center;
}

.ui-modal__title {
    font-size: 22px;
    line-height: 28px;
    font-weight: 600;
}

.ui-modal__subtitle {
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    line-height: 16px;

    color: var(--subtitle-color);
}