.ui-modal__bg {
    background: #33415599;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 20;
}

.ui-modal {
    top: 50%;
    left: 50%;
    position: absolute;
    transform: translate(-50%, -50%);
    width: 320px;

    border: 1px solid var(--border-color);
    background: #fff;
}

.ui-modal__content {
    width: 100%;
    padding: 30px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;

    text-align: center;
}

.ui-modal__title {
    font-size: 22px;
    line-height: 28px;
    font-weight: 600;
}

.ui-modal__subtitle {
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    line-height: 16px;

    color: var(--subtitle-color);
}

/* Открытие/закрытие модалки (Transition name="ui-modal"):
   фон затемняется, окно всплывает с лёгким овершутом */
.ui-modal-enter-active,
.ui-modal-leave-active {
    transition: opacity 0.25s ease;
}
.ui-modal-enter-active .ui-modal {
    transition: transform 0.3s cubic-bezier(0.34, 1.45, 0.64, 1);
}
.ui-modal-leave-active .ui-modal {
    transition: transform 0.2s ease;
}
.ui-modal-enter-from,
.ui-modal-leave-to {
    opacity: 0;
}
.ui-modal-enter-from .ui-modal,
.ui-modal-leave-to .ui-modal {
    transform: translate(-50%, -46%) scale(0.92);
}