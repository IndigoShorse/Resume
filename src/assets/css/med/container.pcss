.ui-container--default {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 20px 0;
}

.ui-container--inset {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 20px 0;
    border-radius: 16px;
    background: #F1F5F9;
    box-shadow: inset 0 0 4px 0 rgba(0, 0, 0, 0.1);
}

.ui-container--row {
    display: flex;
    justify-content: space-between;
}

.ui-container--centered {
    display: flex;
    justify-content: center;
    position: absolute;
    top: 45vh;
    left: 50%;
    transform: translate(-50%, -50%);
}


.ui-layout-container {
    display: flex;
}

.ui-layout-container--col {
    flex-direction: column;
}

.ui-layout-container--row {
    flex-direction: row;
}

