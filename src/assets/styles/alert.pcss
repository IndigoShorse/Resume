.ui-alert {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.ui-alert svg{
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    padding: 0 20px;
}

.ui-alert__text {
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    color: #64748B;
    letter-spacing: 1px;
}