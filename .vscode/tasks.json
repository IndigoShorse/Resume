{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "astro: dev",
      "type": "shell",
      "command": "npm run dev -- --host",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      // Фоновая задача: VS Code считает сервер «запустившимся»,
      // когда в выводе появляется строка Local http://...
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro",
          "endsPattern": "(Local\\s+http|ready in)"
        }
      }
    },
    {
      "label": "astro: build",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "astro: preview",
      "type": "shell",
      "command": "npm run preview -- --host",
      "problemMatcher": []
    }
  ]
}
