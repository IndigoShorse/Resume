{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "cmd.exe",
        "args": ["/d", "/c"]
      }
    }
  },
  "tasks": [
    {
      "label": "astro: dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "4321"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "astro",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro dev|Starting dev server",
          "endsPattern": "Local\\s+http://|ready in"
        }
      }
    },
    {
      "label": "astro: build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "astro: preview",
      "type": "shell",
      "command": "npm",
      "args": ["run", "preview", "--", "--host", "127.0.0.1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
